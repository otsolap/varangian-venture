---
import ThemeLayout from 'varangian-theme/layouts/Layout.astro';
import navigation from '../data/navigation.json';
import site from '../data/site.json';
import seo from '../data/seo.json';
import {
	absoluteUrl,
	buildPageGraph,
	canonicalUrl,
	fullTitle,
	robotsContent,
	serializeJsonLd,
	twitterSite,
} from '../lib/seo';
import { resolveLocalImage } from 'varangian-theme/lib/images.ts';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	image?: string;
	imageAlt?: string;
}

const { title, description, noindex = false, image, imageAlt } = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const pageTitle = fullTitle(title, site.title);
const canonical = noindex ? undefined : canonicalUrl(siteUrl, Astro.url.pathname);
const siteImage = seo.image?.src ? resolveLocalImage(seo.image.src) : undefined;
const shareSrc = image ?? siteImage?.src;
const shareAlt = imageAlt ?? (image ? undefined : seo.image?.alt);
const imageUrl = shareSrc ? absoluteUrl(siteUrl, shareSrc) : undefined;
const jsonLd = noindex
	? undefined
	: serializeJsonLd(
			buildPageGraph(siteUrl, {
				path: Astro.url.pathname,
				title: pageTitle,
				description,
			}),
		);
---

<ThemeLayout
	navigation={navigation}
	pageTitle={pageTitle}
	description={description}
	robots={robotsContent(noindex)}
	canonical={canonical}
	siteName={site.title}
	imageUrl={imageUrl}
	imageAlt={shareAlt}
	imageWidth={!image && siteImage?.width ? siteImage.width : undefined}
	imageHeight={!image && siteImage?.height ? siteImage.height : undefined}
	twitterSite={twitterSite}
	jsonLd={jsonLd}
>
	<slot />
</ThemeLayout>
