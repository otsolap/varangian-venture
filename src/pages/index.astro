---
import Layout from '../layouts/Layout.astro';
import Hero from 'varangian-theme/components/blocks/Hero.astro';
import Cards from 'varangian-theme/components/blocks/Cards.astro';
import Banner from 'varangian-theme/components/blocks/Banner.astro';
import TextAndImage from 'varangian-theme/components/blocks/TextAndImage.astro';
import SubscribeForm from 'varangian-theme/components/blocks/SubscribeForm.astro';
import forms from '../data/forms.json';
import home from '../data/home.json';
---

<Layout {...(home.meta ?? {})}>
	<main>
		<Hero {...home.hero} />

		<Cards {...home.cards} />

		<TextAndImage {...home.textAndImage} />

		<SubscribeForm {...forms.subscribeForm} />

		<Banner {...home.banner} />
	</main>
</Layout>
