---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/blocks/Hero.astro';
import Cards from '../components/blocks/Cards.astro';
import Banner from '../components/blocks/Banner.astro';
import TextAndImage from '../components/blocks/TextAndImage.astro';
import SubscribeForm from '../components/blocks/SubscribeForm.astro';
import home from '../data/home.json';
---

<Layout {...(home.meta ?? {})}>
	<main>
		<Hero {...home.hero} />

		<Cards {...home.cards} />

		<TextAndImage {...home.textAndImage} />

		<SubscribeForm {...home.subscribe} />

		<Banner {...home.banner} />
	</main>
</Layout>
