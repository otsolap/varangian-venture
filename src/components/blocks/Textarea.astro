---
interface Props {
	id?: string;
	title?: string;
	description?: string | string[];
	selectTheme?: 'primary' | 'secondary' | 'tertiary';
}

const { id, title, description, selectTheme = 'secondary' } = Astro.props;
const paragraphs = Array.isArray(description)
	? description.filter(Boolean)
	: description
		? [description]
		: [];
const show = Boolean(title || paragraphs.length);
---

{
	show && (
		<section
			class:list={[
				'content',
				`bg-${selectTheme}`,
				{ 'color-black': selectTheme === 'primary' },
			]}
			id={id}
		>
			{title && <h2>{title}</h2>}
			{paragraphs.map((paragraph) => (
				<p>{paragraph}</p>
			))}
		</section>
	)
}

<style>
	.content {
		margin-right: auto;
		margin-left: auto;
		width: 100%;
		word-wrap: break-word;
		padding-left: var(--spacing-double);
		padding-right: var(--spacing-double);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-single);
	}

	@media (width >= 1440px) {
		.content {
			max-width: var(--container-desktop);
			border-radius: var(--spacing-single-quarter);
		}
	}
</style>
