---
interface MobileLink {
	href: string;
	title: string;
}

interface Props {
	links?: MobileLink[];
}

const PRIMARY_PAGES = 3;
const { links = [] } = Astro.props;
const primary = links.slice(0, PRIMARY_PAGES);
const extra = links.slice(PRIMARY_PAGES);
const itemCount = primary.length + (extra.length > 0 ? 1 : 0);
---

{
	primary.length > 0 && (
		<>
			{
				extra.length > 0 && (
					<div
						class="sidebar"
						id="mobile-sidebar"
						data-mobile-sidebar
						role="dialog"
						aria-label="Menu"
						aria-hidden="true"
					>
						<ul class="content">
							{extra.map((link) => (
								<li class="linkWrapper">
									<a class="sidebarLink" href={link.href} data-close-menu>
										{link.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}
			<footer
				class="mobile"
				data-mobile-footer
				style={`--mobile-nav-count: ${itemCount}`}
			>
				<div class="menuWrapper">
					{
						primary.map((link) => (
							<a class="link" href={link.href} data-close-menu>
								<span class="text">{link.title}</span>
							</a>
						))
					}
					{
						extra.length > 0 && (
							<button
								class="toggle"
								type="button"
								data-menu-toggle
								aria-expanded="false"
								aria-controls="mobile-sidebar"
							>
								<span class="icon" aria-hidden="true">
									<svg class="iconOpen" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2">
										<path d="M4 7h16M4 12h16M4 17h16"></path>
									</svg>
									<svg class="iconClose" viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" hidden>
										<path d="M6 6l12 12M18 6L6 18"></path>
									</svg>
								</span>
								<span class="text" data-menu-label>Menu</span>
							</button>
						)
					}
				</div>
			</footer>
		</>
	)
}

<script>
	function initMobileFooter() {
		const footer = document.querySelector('[data-mobile-footer]');
		if (!(footer instanceof HTMLElement)) return;

		const sidebar = document.querySelector('[data-mobile-sidebar]');
		const toggle = document.querySelector('[data-menu-toggle]');
		const label = toggle?.querySelector('[data-menu-label]');
		const iconOpen = toggle?.querySelector('.iconOpen');
		const iconClose = toggle?.querySelector('.iconClose');
		let lastScrollY = window.scrollY;
		let open = false;

		function setOpen(next: boolean) {
			open = next;
			sidebar?.classList.toggle('show', open);
			sidebar?.setAttribute('aria-hidden', String(!open));
			footer.style.opacity = '1';
			toggle?.setAttribute('aria-expanded', String(open));
			if (label) label.textContent = open ? 'Close' : 'Menu';
			iconOpen?.toggleAttribute('hidden', open);
			iconClose?.toggleAttribute('hidden', !open);
		}

		toggle?.addEventListener('click', () => setOpen(!open));
		document.querySelectorAll('[data-close-menu]').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});
		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && open) setOpen(false);
		});
		window.addEventListener(
			'scroll',
			() => {
				if (open) {
					footer.style.opacity = '1';
					return;
				}
				const y = window.scrollY;
				footer.style.opacity = y > lastScrollY ? '0.5' : '1';
				lastScrollY = y;
			},
			{ passive: true },
		);
	}

	initMobileFooter();
</script>

<style>
	.mobile {
		border-top: 2px solid var(--color-white);
		background-color: var(--color-primary-dark);
		position: fixed;
		bottom: 0;
		left: 0;
		width: 100%;
		z-index: 50;
		text-align: center;
	}

	.menuWrapper {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
	}

	.link,
	.toggle {
		background-color: inherit;
		border: 1px solid transparent;
		color: var(--color-white);
		position: relative;
		width: var(--spacing-quintuple);
		height: var(--spacing-quadruple);
		text-align: center;
		transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
		z-index: 10;
		cursor: pointer;
		flex: 0 0 calc(100% / var(--mobile-nav-count, 3));
		max-width: calc(100% / var(--mobile-nav-count, 3));
		text-decoration-line: none;
		font-weight: 700;
	}

	.link:hover,
	.link:focus,
	.toggle:hover,
	.toggle:focus {
		color: var(--color-secondary-semidark);
	}

	.icon {
		display: flex;
		justify-content: center;
		margin-top: var(--spacing-half);
		height: 1.875rem;
		width: 100%;
	}

	.text {
		display: flex;
		justify-content: center;
		width: 100%;
		font-size: 0.75rem;
		line-height: 1.625;
	}

	.sidebar {
		background-color: var(--color-primary-dark);
		position: fixed;
		top: 0;
		right: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		height: 100%;
		width: 100%;
		padding-top: var(--spacing-quintuple);
		transition: transform 0.5s ease-in-out;
		z-index: 5;
		transform: translateX(100%);
	}

	.sidebar.show {
		transform: translateX(0);
	}

	.content {
		position: sticky;
		width: inherit;
		z-index: 10;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.linkWrapper {
		padding-top: var(--spacing-single);
		padding-bottom: var(--spacing-single);
		padding-left: var(--spacing-triple);
		list-style: none;
		border-bottom: 2px solid var(--color-white);
	}

	.sidebarLink {
		display: block;
		color: var(--color-white);
		font-size: 22px;
		width: inherit;
		height: inherit;
	}

	@media (width >= 768px) {
		.mobile,
		.sidebar {
			display: none;
		}
	}
</style>
